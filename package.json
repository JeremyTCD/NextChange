{
  "name": "vscode-change-iterator",
  "displayName": "Change Iterator",
  "description": "Navigate through changed files and changes within files using keyboard shortcuts",
  "version": "1.0.0",
  "publisher": "JeremyTCD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeremyTCD/NextChange"
  },
  "keywords": [
    "git",
    "changes",
    "navigation",
    "diff",
    "source control",
    "keyboard shortcuts"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "changeIterator.nextChange",
        "title": "Go to Next Change"
      },
      {
        "command": "changeIterator.previousChange",
        "title": "Go to Previous Change"
      },
      {
        "command": "changeIterator.nextFile",
        "title": "Go to Next Changed File"
      },
      {
        "command": "changeIterator.previousFile",
        "title": "Go to Previous Changed File"
      }
    ],
    "keybindings": [
      {
        "command": "changeIterator.nextChange",
        "key": "alt+z",
        "mac": "alt+z"
      },
      {
        "command": "changeIterator.previousChange",
        "key": "alt+a",
        "mac": "alt+a"
      },
      {
        "command": "changeIterator.nextFile",
        "key": "ctrl+alt+z",
        "mac": "ctrl+alt+z"
      },
      {
        "command": "changeIterator.previousFile",
        "key": "ctrl+alt+a",
        "mac": "ctrl+alt+a"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "glob": "^8.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
